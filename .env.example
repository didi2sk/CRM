CAFLOU_BASE_URL=https://app.caflou.com/api/v1
CAFLOU_ACCOUNT_ID=
CAFLOU_TOKEN=
# Stranka a velkost stranky - nazvy parametrov mozu byt ine, over v Postman dokumentacii
CAFLOU_PER_PAGE=100
CAFLOU_PAGE_PARAM=page
CAFLOU_PER_PAGE_PARAM=per_page
# Pauza medzi requestmi v milisekundach (rate limit)
CAFLOU_DELAY_MS=300

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=caflou_backup
DB_USER=root
DB_PASS=
